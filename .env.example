POSTGRES_DB=telemetryflow
POSTGRES_USER=telemetryflow
# Set by scripts/setup.sh; use unique local credentials.
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://telemetryflow:replace-with-random-password@127.0.0.1:5433/telemetryflow
ADMIN_TOKEN=replace-with-random-token
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
INGEST_INTERVAL=2
BUFFER_LIMIT=5000
BATCH_SIZE=500
SIMULATION_SEED=42
MACHINE_COUNT=5
RETENTION_DAYS=7
